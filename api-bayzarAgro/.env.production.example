APP_NAME=BayzarAgro
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

CORS_ALLOWED_ORIGINS=https://example.com
PASSPORT_ACCESS_TOKEN_DAYS=1
PASSPORT_REFRESH_TOKEN_DAYS=30
PASSPORT_PERSONAL_ACCESS_TOKEN_DAYS=1
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=false

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=/cloudsql/project-id:us-central1:bayzar-agro-db
DB_DATABASE=bayzaragro
DB_USERNAME=bayzaragro
DB_PASSWORD=

INITIAL_ADMIN_EMAIL=admin@bayzaragro.demo
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_LAST_NAME=Demo

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
